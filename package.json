{
  "name": "videojs-story-view",
  "version": "1.0.0",
  "description": "Instagram-style stories for the web: a tiny <story-view> custom element and a Video.js 8 plugin.",
  "keywords": [
    "stories",
    "story-view",
    "instagram",
    "custom-element",
    "web-component",
    "video",
    "videojs",
    "videojs-plugin"
  ],
  "homepage": "https://hicay.github.io/videojs-story-view/",
  "bugs": {
    "url": "https://github.com/hicay/videojs-story-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hicay/videojs-story-view.git"
  },
  "license": "MIT",
  "author": "Salih Caglar Ispirli <caglarispirli@gmail.com>",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/videojs-story-view.iife.js",
    "./src/define.ts",
    "./src/cdn.ts",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./videojs": {
      "types": "./dist/videojs.d.ts",
      "default": "./dist/videojs.js"
    },
    "./style.css": "./dist/videojs-story-view.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/videojs-story-view.iife.js",
  "jsdelivr": "./dist/videojs-story-view.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build && vite build --mode iife",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview:demo": "vite preview --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run size",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "video.js": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "video.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@videojs/html": "^10.7.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "video.js": "^8.24.1",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
